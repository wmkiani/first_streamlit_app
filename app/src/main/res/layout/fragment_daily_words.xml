<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/daily_words_title"
            android:textAppearance="@style/TextAppearance.ArabicLearningApp.Headline1"
            android:textColor="@color/text_primary" />

        <!-- Word of the Day -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/word_of_the_day"
                    android:textAppearance="@style/TextAppearance.ArabicLearningApp.Headline2"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/word_of_day_arabic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="مرحبا"
                    android:textAppearance="@style/TextAppearance.ArabicLearningApp.Headline1"
                    android:textColor="@color/primary"
                    android:textDirection="rtl"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/word_of_day_transliteration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="Marhaba"
                    android:textAppearance="@style/TextAppearance.ArabicLearningApp.Body1"
                    android:textColor="@color/text_secondary"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/word_of_day_english"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="Hello"
                    android:textAppearance="@style/TextAppearance.ArabicLearningApp.Body1"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/word_of_day_urdu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:text="ہیلو"
                    android:textAppearance="@style/TextAppearance.ArabicLearningApp.Body1"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/practice_word_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="@string/practice_now"
                    app:icon="@drawable/ic_practice" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Practice Sections -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <!-- New Words -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/new_words_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_new_words"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/new_words"
                        android:textAppearance="@style/TextAppearance.ArabicLearningApp.Body1"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/new_words_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="5 words"
                        android:textAppearance="@style/TextAppearance.ArabicLearningApp.Body2"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Review Words -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/review_words_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_review"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/review_words"
                        android:textAppearance="@style/TextAppearance.ArabicLearningApp.Body1"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/review_words_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="12 words"
                        android:textAppearance="@style/TextAppearance.ArabicLearningApp.Body2"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Recent Words -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Recent Words"
            android:textAppearance="@style/TextAppearance.ArabicLearningApp.Headline2"
            android:textColor="@color/text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_words_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_word" />

    </LinearLayout>

</ScrollView>